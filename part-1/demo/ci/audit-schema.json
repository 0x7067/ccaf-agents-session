{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "description": "Two-sentence executive summary of the audit"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "unclear"]
          },
          "dimension": {
            "type": "string",
            "enum": ["a11y", "copy", "code", "other"]
          },
          "dimension_detail": {
            "type": ["string", "null"],
            "description": "Details if dimension = 'other'. Null otherwise."
          },
          "file": {
            "type": "string",
            "description": "Repo-relative path where the issue lives"
          },
          "line": {
            "type": ["integer", "null"],
            "description": "Line number if known, null if the finding is file-wide (e.g. a JSON key)"
          },
          "issue": { "type": "string" },
          "suggested_fix": {
            "type": ["string", "null"],
            "description": "One-line fix. Null if no obvious fix."
          }
        },
        "required": ["severity", "dimension", "file", "issue"]
      }
    }
  },
  "required": ["summary", "findings"]
}
